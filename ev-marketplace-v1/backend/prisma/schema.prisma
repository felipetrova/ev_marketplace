generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DRIVER
  HOST
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum StationStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ConnectorStatus {
  AVAILABLE
  RESERVED
  CHARGING
  OFFLINE
  MAINTENANCE
}

enum PricingType {
  PER_HOUR
  EXPRESS
  MONTHLY_BUNDLE
  PER_KWH
  COMBINED
  CUSTOM
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SessionStatus {
  CREATED
  RUNNING
  FINISHED
  CANCELLED
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  phone             String?
  role              UserRole           @default(DRIVER)
  status            UserStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  vehicles          Vehicle[]
  host              Host?
  reservations      Reservation[]
  reviews           Review[]
  planSubscriptions PlanSubscription[]
}

model Vehicle {
  id            String        @id @default(uuid())
  userId        String
  brand         String?
  model         String?
  year          Int?
  plate         String?
  batteryKwh    Decimal?      @db.Decimal(10, 2)
  connectorType String?
  user          User          @relation(fields: [userId], references: [id])
  reservations  Reservation[]
  createdAt     DateTime      @default(now())
}

model Host {
  id        String            @id @default(uuid())
  userId    String            @unique
  verified  Boolean           @default(false)
  user      User              @relation(fields: [userId], references: [id])
  stations  ChargingStation[]
  createdAt DateTime          @default(now())
}

model ChargingStation {
  id            String        @id @default(uuid())
  hostId        String
  name          String
  description   String?
  address       String
  city          String
  state         String
  latitude      Decimal       @db.Decimal(10, 7)
  longitude     Decimal       @db.Decimal(10, 7)
  status        StationStatus @default(DRAFT)
  operatingFrom String?
  operatingTo   String?
  host          Host          @relation(fields: [hostId], references: [id])
  connectors    Connector[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Connector {
  id           String            @id @default(uuid())
  stationId    String
  type         String
  powerKw      Decimal?          @db.Decimal(10, 2)
  status       ConnectorStatus   @default(AVAILABLE)
  station      ChargingStation   @relation(fields: [stationId], references: [id])
  reservations Reservation[]
  sessions     ChargingSession[]
  createdAt    DateTime          @default(now())
}

model PricingPlan {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  description     String?
  type            PricingType
  price           Decimal            @db.Decimal(10, 2)
  includedCharges Int?
  durationMinutes Int?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  subscriptions   PlanSubscription[]
  reservations    Reservation[]
}

model PlanSubscription {
  id        String      @id @default(uuid())
  userId    String
  planId    String
  startsAt  DateTime    @default(now())
  endsAt    DateTime?
  active    Boolean     @default(true)
  user      User        @relation(fields: [userId], references: [id])
  plan      PricingPlan @relation(fields: [planId], references: [id])
  createdAt DateTime    @default(now())
}

model Reservation {
  id             String            @id @default(uuid())
  userId         String
  vehicleId      String
  connectorId    String
  pricingPlanId  String?
  startsAt       DateTime
  endsAt         DateTime
  status         ReservationStatus @default(PENDING_PAYMENT)
  grossAmount    Decimal           @db.Decimal(10, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  netAmount      Decimal           @db.Decimal(10, 2)
  isCourtesy     Boolean           @default(false)
  user           User              @relation(fields: [userId], references: [id])
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id])
  connector      Connector         @relation(fields: [connectorId], references: [id])
  pricingPlan    PricingPlan?      @relation(fields: [pricingPlanId], references: [id])
  payment        Payment?
  session        ChargingSession?
  review         Review?
  createdAt      DateTime          @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  reservationId String        @unique
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  provider      String?
  providerRef   String?
  paidAt        DateTime?
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  createdAt     DateTime      @default(now())
}

model ChargingSession {
  id              String        @id @default(uuid())
  reservationId   String        @unique
  connectorId     String
  status          SessionStatus @default(CREATED)
  startedAt       DateTime?
  endedAt         DateTime?
  energyKwh       Decimal?      @db.Decimal(10, 3)
  durationSeconds Int?
  source          String        @default("MVP")
  reservation     Reservation   @relation(fields: [reservationId], references: [id])
  connector       Connector     @relation(fields: [connectorId], references: [id])
  createdAt       DateTime      @default(now())
}

model Review {
  id            String      @id @default(uuid())
  reservationId String      @unique
  userId        String
  rating        Int
  comment       String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
}
